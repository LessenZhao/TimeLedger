#!/usr/bin/env bash
# Build an isolated TimeLedger development .app. It never overwrites or removes
# another app; installation requires an empty, explicitly selected directory.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HUB="${ROOT}/EvolutionHub"
APP_NAME="TimeLedger Dev.app"
BIN_NAME="EvolutionHub"

verify_app_resources() {
  local app_path="$1"
  local resources="${app_path}/Contents/Resources"
  local bundle="${resources}/EvolutionHub_EvolutionHub.bundle"
  local resource
  local required=(
    "index.html"
    "reader.css"
    "reader.js"
    "markdown-it-14.1.0.min.js"
    "markdown-it-14.1.0-LICENSE"
    "markdown-it-footnote-4.0.0.min.js"
    "markdown-it-footnote-4.0.0-LICENSE"
    "recogito-text-annotator-4.2.5.umd.js"
    "recogito-text-annotator-4.2.5.css"
    "recogito-text-annotator-4.2.5-LICENSE"
    "recogito-env.js"
    "THIRD_PARTY.md"
  )

  if [[ ! -d "${bundle}" ]]; then
    echo "Missing resource bundle: ${bundle}" >&2
    return 1
  fi
  for resource in "${required[@]}"; do
    if [[ ! -f "${bundle}/${resource}" ]]; then
      echo "Missing reader resource: ${bundle}/${resource}" >&2
      return 1
    fi
  done
}

if [[ "${1:-}" == "--verify-app" ]]; then
  if [[ -z "${2:-}" || "${3:-}" != "" ]]; then
    echo "Usage: $0 --verify-app /absolute/path/to/TimeLedger Dev.app" >&2
    exit 64
  fi
  verify_app_resources "$2"
  echo "Verified reader resources: $2"
  exit 0
fi

BUILD_ROOT="${EVOLUTION_HUB_BUILD_ROOT:-/private/tmp}"
mkdir -p "${BUILD_ROOT}"
BUILD_DIR="$(mktemp -d "${BUILD_ROOT%/}/timeledger-dev-build.XXXXXX")"
APP_PATH="${BUILD_DIR}/${APP_NAME}"

echo "==> Building Release..."
swift build -c release --package-path "${HUB}"

BIN_DIR="$(swift build -c release --package-path "${HUB}" --show-bin-path)"
BIN="${BIN_DIR}/${BIN_NAME}"
RESOURCE_BUNDLE="${BIN_DIR}/EvolutionHub_EvolutionHub.bundle"
if [[ ! -x "${BIN}" ]]; then
  echo "Executable not found: ${BIN}" >&2
  exit 1
fi
if [[ ! -d "${RESOURCE_BUNDLE}" ]]; then
  echo "SwiftPM resource bundle not found: ${RESOURCE_BUNDLE}" >&2
  exit 1
fi

echo "==> Assembling app bundle..."
mkdir -p "${APP_PATH}/Contents/MacOS"
mkdir -p "${APP_PATH}/Contents/Resources"

cp "${HUB}/AppBundle/Info.plist" "${APP_PATH}/Contents/Info.plist"
# Bump bundle version with build timestamp so Finder/LaunchServices refresh
if command -v plutil >/dev/null 2>&1; then
  BUILD_TS="$(date +%Y%m%d%H%M%S)"
  plutil -replace CFBundleVersion -string "${BUILD_TS}" "${APP_PATH}/Contents/Info.plist"
fi
cp "${BIN}" "${APP_PATH}/Contents/MacOS/${BIN_NAME}"
chmod +x "${APP_PATH}/Contents/MacOS/${BIN_NAME}"
cp -R "${RESOURCE_BUNDLE}" "${APP_PATH}/Contents/Resources/"

# Verify every vendored reader resource survived both SwiftPM processing and
# app assembly. The app-level check below also protects the shipped artifact.
while IFS= read -r -d '' resource; do
  name="$(basename "${resource}")"
  if [[ ! -f "${RESOURCE_BUNDLE}/${name}" ]]; then
    echo "SwiftPM omitted reader resource: ${name}" >&2
    exit 1
  fi
done < <(find "${HUB}/Sources/EvolutionHub/Resources/ObsidianReader" -type f -print0)
verify_app_resources "${APP_PATH}"

if command -v codesign >/dev/null 2>&1; then
  codesign --force --deep --sign - "${APP_PATH}" 2>/dev/null || true
fi

if [[ -n "${EVOLUTION_HUB_INSTALL_DIR:-}" ]]; then
  INSTALLED_APP="${EVOLUTION_HUB_INSTALL_DIR}/${APP_NAME}"
  if [[ -e "${INSTALLED_APP}" ]]; then
    echo "Refusing to overwrite existing development app: ${INSTALLED_APP}" >&2
    exit 1
  fi
  mkdir -p "${EVOLUTION_HUB_INSTALL_DIR}"
  cp -R "${APP_PATH}" "${INSTALLED_APP}"
  verify_app_resources "${INSTALLED_APP}"
  echo "Installed:  ${INSTALLED_APP}"
fi

echo ""
echo "Done."
echo "  Built:     ${APP_PATH}"
echo ""
echo "Temporary install acceptance:"
echo "  EVOLUTION_HUB_INSTALL_DIR=/private/tmp/timeledger-dev-install scripts/build-evolution-hub-app"
echo "Open the reported TimeLedger Dev.app only after choosing an install directory."
